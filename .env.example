# ==============================================================================
# PANDUAN KONFIGURASI ENVIRONMENT (.env) - AI STOCK SCANNER INDONESIA
# ==============================================================================
# Salin file ini menjadi '.env' di direktori root sebelum menjalankan aplikasi:
#   cp .env.example .env
#
# PERINGATAN KEAMANAN:
# File '.env' berisi data rahasia/kredensial pribadi. JANGAN PERNAH mengunggah
# file '.env' ke GitHub / repository publik!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. KONFIGURASI BOT TELEGRAM (WAJIB DIISI MANUAL)
# ------------------------------------------------------------------------------
# Buat bot baru melalui BotFather di Telegram:
#   1. Buka Telegram dan cari akun @BotFather
#   2. Kirim perintah /newbot dan ikuti langkah penamaannya
#   3. Salin API token yang diberikan ke variabel di bawah ini:
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Dapatkan Chat ID Telegram Anda:
#   1. Cari bot @userinfobot di Telegram atau kirim pesan apapun ke bot Anda
#   2. Buka di browser: https://api.telegram.org/bot<TOKEN_BOT_ANDA>/getUpdates
#   3. Cari bagian "chat":{"id":123456789...} lalu masukkan angka tersebut di bawah:
TELEGRAM_CHAT_ID=your_telegram_chat_id_here


# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI - SENTIMEN BERITA (OPSIONAL / SANGAT DIREKOMENDASIKAN)
# ------------------------------------------------------------------------------
# Digunakan untuk analisis sentimen berita saham dan pasar IDX berbasis AI:
#   1. Kunjungi: https://aistudio.google.com/app/apikey
#   2. Buat API Key baru (Gratis)
#   3. Salin API Key ke variabel di bawah:
GEMINI_API_KEY=your_gemini_api_key_here


# ------------------------------------------------------------------------------
# 3. MODAL & MANAJEMEN RISIKO (DEFAULT PENGGUNA)
# ------------------------------------------------------------------------------
# Modal trading default dalam Rupiah (dapat diubah per-user di Telegram via /modal)
CAPITAL_AMOUNT=3000000

# Persentase risiko modal per transaksi (contoh: 0.02 = 2% dari modal)
RISK_PER_TRADE=0.02

# Persentase batas Stop Loss default (contoh: 0.03 = 3% dari titik entry)
STOP_LOSS_PCT=0.03

# Batas maksimal sinyal BUY harian yang dikirim ke Telegram
MAX_SIGNALS_PER_DAY=5


# ------------------------------------------------------------------------------
# 4. UNIVERSE PEMINDAIAN SAHAM IDX
# ------------------------------------------------------------------------------
# static = Menggunakan daftar saham di src/config/tickers.json (~100 saham likuid)
# idx    = Memindai seluruh emiten BEI (~750+ saham IDX dengan pre-screening volume)
SCAN_UNIVERSE=idx

# Batas jumlah ticker yang discan (0 = tidak dibatasi / seluruh universe)
MAX_TICKERS_TO_SCAN=0


# ------------------------------------------------------------------------------
# 5. MITIGASI RATE-LIMIT & STABILITAS FETCH DATA (YAHOO FINANCE & TRADINGVIEW)
# ------------------------------------------------------------------------------
# Batching dan jitter delay untuk mencegah pembatasan akses / HTTP 429
BATCH_SIZE=50
CONCURRENCY_LIMIT=5
ADAPTIVE_BATCHING=true
YAHOO_MAX_RETRIES=4
YAHOO_REQUEST_TIMEOUT_MS=20000
INTER_REQUEST_DELAY_MIN_MS=4000
INTER_REQUEST_DELAY_MAX_MS=6000
BATCH_DELAY_MIN_MS=15000
BATCH_DELAY_MAX_MS=20000


# ------------------------------------------------------------------------------
# 6. ZONA WAKTU SISTEM
# ------------------------------------------------------------------------------
# Mengikuti jam operasional Bursa Efek Indonesia (WIB)
TZ=Asia/Jakarta
